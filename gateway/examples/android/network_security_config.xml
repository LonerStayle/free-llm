<?xml version="1.0" encoding="utf-8"?>
<!-- res/xml/network_security_config.xml (디버그 빌드 전용 권장: src/debug/res/xml/)
     게이트웨이가 http 라서 해당 주소만 cleartext 를 허용한다. 맥 IP/Tailscale 이름은 실제 값으로 바꾼다. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>       <!-- 에뮬레이터 -->
        <domain includeSubdomains="false">localhost</domain>      <!-- adb reverse -->
        <domain includeSubdomains="false">192.168.0.10</domain>   <!-- 같은 Wi-Fi 의 맥 IP -->
    </domain-config>
</network-security-config>
