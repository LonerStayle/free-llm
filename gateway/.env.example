# .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다. 권한: chmod 600 .env
# 앱이 보낼 키. 생성: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# 127.0.0.1: 이 맥 + 에뮬레이터 + adb reverse / 0.0.0.0: 같은 Wi-Fi 의 기기도 허용
BIND_ADDR=127.0.0.1

# 필수
OPENROUTER_API_KEY=

# 선택. 발급 후 config.yaml 의 해당 항목 주석을 해제한다
REQUESTY_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
